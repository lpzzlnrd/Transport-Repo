# Copia este archivo como .env (en esta misma carpeta raíz) y pon tu clave.
# El archivo .env está en .gitignore, así que NO se sube al repositorio.

# Clave de la API de Groq (https://console.groq.com -> API Keys).
GROQ_API_KEY=gsk_tu_clave_aqui

# (Opcional) Modelo a usar. Si se omite, usa llama-3.1-8b-instant.
GROQ_MODELO=llama-3.1-8b-instant
